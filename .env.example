# Local application database (the Docker Compose app-db service publishes port 5433).
CRAWLTECH_DATABASE_URL=postgresql+psycopg2://crawltech:crawltech@localhost:5433/crawltech
CRAWLTECH_IMAGE_STORAGE_PATH=./data/images
CRAWLTECH_CRAWL_BATCH_SIZE=10
CRAWLTECH_LOG_LEVEL=INFO

# Local-only Airflow login. Change these before exposing Airflow beyond localhost.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=localdev
AIRFLOW_UID=50000